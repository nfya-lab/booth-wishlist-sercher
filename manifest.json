{
  "manifest_version": 3,
  "name": "BOOTH スキリスト検索・ソート",
  "version": "1.6.1",
  "description": "BOOTHの「スキした商品」ページに検索・ソート機能を追加します",
  "content_scripts": [
    {
      "matches": [
        "https://accounts.booth.pm/wish_lists*",
        "https://booth.pm/wish_list_names/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
